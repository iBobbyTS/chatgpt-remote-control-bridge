{
  "name": "chatgpt-remote-control-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "把本地 ZCode 桥接到 codex 的 ChatGPT 远程控制后端（wham）",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cgrcb": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/*.test.ts\"",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli/main.js",
    "auth": "tsx src/cli.ts",
    "wham": "tsx src/wham/cli.ts",
    "wham:probe": "tsx src/wham/probe-cli.ts",
    "wham:proxy": "tsx src/wham/proxy.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
